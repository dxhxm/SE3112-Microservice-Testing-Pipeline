{
  "name": "arena-e2e-selenium",
  "version": "1.0.0",
  "description": "SE3112 UI and E2E Testing Suite for Arena Microservices using Selenium WebDriver",
  "main": "dist/index.js",
  "scripts": {
    "test": "mocha --config .mocharc.json",
    "test:e2e": "mocha --config .mocharc.json",
    "test:e2e:headed": "cross-env HEADLESS=false mocha --config .mocharc.json",
    "test:e2e:report": "npx marge mochawesome-report/mochawesome.json --reportDir mochawesome-report --inline"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "selenium-webdriver": "^4.28.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.0",
    "@types/selenium-webdriver": "^4.1.28",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.1",
    "mochawesome": "^7.1.3",
    "mochawesome-report-generator": "^6.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
