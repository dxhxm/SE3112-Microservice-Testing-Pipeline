{
  "reporterEnabled": "spec, mochawesome, mocha-junit-reporter",
  "mochawesomeReporterOptions": {
    "reportDir": "mochawesome-report",
    "reportFilename": "e2e-report",
    "html": true,
    "json": true,
    "charts": true,
    "overwrite": true
  },
